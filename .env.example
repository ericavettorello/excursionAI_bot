BOT_TOKEN=
LOG_LEVEL=INFO

# PostgreSQL. Локально: 127.0.0.1. В Docker Compose на VPS: DB_HOST=db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=excursion_ai
DB_USER=excursion_ai_app
DB_PASSWORD=

# Числовые Telegram ID администраторов через запятую. Пусто = админ-доступ закрыт.
ADMIN_IDS=
CATALOG_CACHE_TTL_SECONDS=60

# ИИ-консультант (Responses API). Не включайте, пока не зададите ключ и модель.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=200
# Отдельный дневной лимит админ-переводов экскурсий (не списывает клиентскую квоту).
AI_ADMIN_TRANSLATION_DAILY_LIMIT=50
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=800
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# amoCRM (API v4 + OAuth 2.0). Пока false — заявки сохраняются со статусом not_connected.
AMOCRM_ENABLED=false
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
# Опционально: файл для атомарного сохранения обновлённых токенов (не коммитьте).
# В Docker на VPS обычно: /app/data/amocrm_tokens.json
AMOCRM_TOKEN_STORE_PATH=
# Воронка и этап: либо имена (поиск через API), либо оба ID.
# Без совпадения сделка НЕ создаётся (нет fallback на «Покупка»).
AMOCRM_PIPELINE_NAME=ЭКСКУРСИИ
AMOCRM_STATUS_NAME=Новая заявка
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
# Поле «Участники» ищется по точному имени; если нет — создаётся автоматически.
AMOCRM_CF_APPLICATION_ID=
AMOCRM_CF_EXCURSION=
AMOCRM_CF_REQUESTED_DATE=
# Опционально: ожидаемый ID для сверки с найденным/созданным полем «Участники».
AMOCRM_CF_PARTICIPANTS=
AMOCRM_CF_PUBLIC_NUMBER=
AMOCRM_CF_SESSION_DATE=
AMOCRM_CF_SESSION_TIME=
AMOCRM_STATUS_NAME_CONFIRMED=Бронь подтверждена
AMOCRM_STATUS_NAME_CANCELLED=Бронь отменена
AMOCRM_TIMEOUT_SECONDS=30
AMOCRM_MAX_ATTEMPTS=5

# Bot HTTP server: /health is always on (Docker/nginx).
# Enable the amoCRM webhook only behind HTTPS (avoid secrets on plain HTTP).
# First smoke test: AMOCRM_WEBHOOK_ENABLED=false and check GET /health.
AMOCRM_WEBHOOK_ENABLED=false
AMOCRM_WEBHOOK_HOST=0.0.0.0
AMOCRM_WEBHOOK_PORT=8080
AMOCRM_WEBHOOK_PATH=/amocrm/webhook
AMOCRM_WEBHOOK_SECRET=
